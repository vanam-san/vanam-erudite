---
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/themes.css"
import "@/styles/typography.css"
import "@/styles/typography-headings.css"
import "@/styles/typography-inline.css"
import "@/styles/typography-lists.css"
import "@/styles/typography-block.css"
import "@/styles/typography-tables.css"
import "@/styles/typography-math.css"
import "@/styles/callout.css"
import "@/styles/layout.css"
import "@/styles/icon-button.css"
import "@/styles/bar.css"
import "@/styles/shape.css"
import "@/styles/gallery.css"
import "@/styles/bento.css"

import CircuitBackdrop from "@/components/CircuitBackdrop.astro"
import CommandPalette from "@/components/CommandPalette.astro"
import Footer from "@/components/Footer.astro"
import KeyboardShortcuts from "@/components/KeyboardShortcuts.astro"
import MetaHead from "@/components/MetaHead.astro"
import Sidebar from "@/components/Sidebar.astro"
import { SITE } from "@/consts"

type Props = {
  crumbs?: { label: string; href: string }[]
  wide?: boolean
  /** Exclude this page from the Pagefind search index (e.g. 404). */
  noindex?: boolean
}

const { crumbs = [], wide = false, noindex = false } = Astro.props
---

<html lang={SITE.locale} dir={SITE.dir}>
  <MetaHead>
    <slot name="head" />
  </MetaHead>
  <body data-pagefind-ignore={noindex || undefined}>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="bg-noise" aria-hidden="true"></div>
    <div class="bg-orbs" aria-hidden="true"></div>
    <CircuitBackdrop />
    <CommandPalette />
    <page-grid>
      <page-header>
        <page-nav>
          <Sidebar><slot name="actions" slot="actions" /></Sidebar>
        </page-nav>
        {Astro.slots.has("toc") && (
            <page-toc><slot name="toc" /></page-toc>
          )}
      </page-header>
      <page-content class:list={[wide && "wide"]}>
        <main id="main" data-pagefind-body>
          {crumbs.length > 0 && (
            <nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
              <ol>
                {crumbs.map(({ label, href }, index) => (
                  <li>
                    {index === crumbs.length - 1
                      ? <span aria-current="page">{label}</span>
                      : <a href={href}>{label}</a>}
                  </li>
                ))}
              </ol>
            </nav>
          )}
          <slot />
        </main>
        <page-footer><Footer /></page-footer>
      </page-content>
    </page-grid>
    <KeyboardShortcuts />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    inset-block-start: var(--space-xs);
    inset-inline-start: var(--space-xs);
    z-index: 10001;
    padding: var(--space-2xs) var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--primary-foreground, var(--background));
    text-decoration: none;
    background: var(--primary);
    border-radius: var(--radius-md);
    transform: translateY(-300%);
    transition: transform 0.15s ease-out;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  /* Paper grain for depth — whisper-quiet texture */
  .bg-noise {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px 256px;

    @media (width < 64rem) {
      display: none;
    }
  }

  /* Warm paper wash: static, theme-aware, no motion */
  .bg-orbs {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        42rem 30rem at 12% -6%,
        color-mix(in oklab, var(--primary) 10%, transparent),
        transparent 70%
      ),
      radial-gradient(
        38rem 28rem at 88% 8%,
        color-mix(in oklab, var(--secondary) 9%, transparent),
        transparent 70%
      ),
      radial-gradient(
        46rem 34rem at 50% 108%,
        color-mix(in oklab, var(--secondary) 7%, transparent),
        transparent 70%
      );
  }

  page-grid {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    grid-template-rows: auto 1fr;
    gap: var(--grid-gutter);
    max-width: var(--grid-max-width);
    min-height: 100svh;
    margin-inline: auto;
    padding-inline: var(--grid-gutter);

    @media (width < 64rem) {
      grid-template-columns: 1fr;
    }
  }

  page-header {
    display: contents;

    @media (width < 64rem) {
      display: block;
      grid-column: 1 / -1;
      position: sticky;
      top: 0;
      z-index: 10;
      min-width: 0;
      margin-inline: calc(-1 * var(--grid-gutter));
    }
  }

  page-nav {
    display: block;
    min-width: 0;
    grid-column: 1 / -1;
    grid-row: 1;

    @media (width >= 64rem) {
      position: relative;
      z-index: 10;
      border-block-end: 1px solid var(--border);
    }
  }

  page-toc {
    display: block;
    min-width: 0;
    grid-column: 10 / -1;
    grid-row: 2;
  }

  page-content {
    display: flex;
    flex-direction: column;
    grid-column: 1 / -1;
    grid-row: 2;
    inline-size: 100%;
    max-inline-size: var(--measure);
    margin-inline: auto;
    min-width: 0;

    main {
      flex: 1;
    }

    page-footer {
      display: block;
      margin-block-start: var(--space-xl);
    }
  }

  page-content.wide {
    max-inline-size: none;
  }

  @media (width >= 64rem) {
    page-grid:has(page-toc) page-content {
      grid-column: 2 / 10;
    }
  }

  .breadcrumbs {
    margin-block-end: var(--space-s);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs li + li {
    border-inline-start: 1px solid var(--border);
    padding-inline-start: var(--space-2xs);
  }

  .breadcrumbs a {
    color: inherit;
    text-decoration: underline;
  }
</style>
