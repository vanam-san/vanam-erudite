---
import Logo from "@/assets/logo.svg"
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE } from "@/consts"
import { normalizePath } from "@/lib/utils"

type Props = { crumbs?: { label: string; href: string }[] }

const { crumbs = [] } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const section = NAVIGATION.find(
  ({ href }) => pathname === href || pathname.startsWith(`${href}/`),
)
const isHome = pathname === "/"
---

<aside data-bar>
  <sidebar-inner>
    <a href="/" class="desktop-brand" aria-label={SITE.title}>
      <Logo />
      <span>{SITE.title}</span>
    </a>
    <a href="/" class="mobile-brand">{SITE.title}</a>
    <nav>
      <ul>
        <li>
          <a href="/" aria-current={isHome ? "page" : undefined}>Home</a>
        </li>
        {NAVIGATION.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={pathname === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
              {item === section && crumbs.length > 0 && pathname !== item.href && (
                <ul>
                  {crumbs.map((crumb, i) => (
                    <li data-depth={i ? 1 : undefined}>
                      <a
                        href={crumb.href}
                        aria-current={
                          i === crumbs.length - 1 ? "page" : undefined
                        }
                      >
                        {crumb.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        {!section &&
          !isHome &&
            crumbs.map((crumb, i) => (
              <li data-depth={i ? 1 : undefined}>
                <a
                  href={crumb.href}
                  aria-current={i === crumbs.length - 1 ? "page" : undefined}
                >
                  {crumb.label}
                </a>
              </li>
            ))}
      </ul>
    </nav>
  </sidebar-inner>
  <mobile-nav>
    <button
      type="button"
      class="nav-search"
      aria-label="Open search"
      data-open-palette
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
    </button>
    <button
      type="button"
      class="hamburger"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="hamburger-line" aria-hidden="true"></span>
      <span class="hamburger-line" aria-hidden="true"></span>
      <span class="hamburger-line" aria-hidden="true"></span>
    </button>
  </mobile-nav>
  <sidebar-toggle>
    <ThemeToggle />
    <button
      type="button"
      class="cmdk-button"
      aria-label="Open search (Command K)"
      data-open-palette
    >
      <kbd>⌘K</kbd>
    </button>
    <slot name="actions" />
  </sidebar-toggle>
  <div class="mobile-menu" id="mobile-menu">
    <ul>
      <li>
        <a href="/" aria-current={isHome ? "page" : undefined}>Home</a>
      </li>
      {NAVIGATION.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  aside {
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));

    @media (width < 64rem) {
      flex-flow: row wrap;
      align-items: center;
      gap: var(--space-2xs) var(--space-s);
      position: static;
      height: auto;
    }
  }

  sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);

    @media (width < 64rem) {
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      min-width: 0;
    }
  }

  .desktop-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: var(--step-0);
    color: var(--foreground);
    text-decoration-line: none;
    letter-spacing: -0.01em;

    svg {
      inline-size: 1.5rem;
      block-size: 1.5rem;
      flex-shrink: 0;
    }

    @media (width < 64rem) {
      display: none;
    }
  }

  .mobile-brand {
    display: none;

    @media (width < 64rem) {
      display: inline-flex;
      flex: 1;
      align-items: center;
      min-width: 0;
      overflow: hidden;
      font-size: var(--step-0);
      color: var(--foreground);
      text-decoration-line: none;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  /* ── vanam.dev nav: display type, slide + primary on hover ── */
  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    a {
      display: block;
      position: relative;
      font-family: var(--font-display);
      font-size: var(--step-0);
      letter-spacing: normal;
      color: var(--muted-foreground);
      text-decoration: none;
      transition:
        color 0.15s ease,
        transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);

      &:hover {
        color: var(--primary);
        transform: translateX(var(--space-2xs));
      }

      &[aria-current="page"] {
        color: var(--foreground);
        text-decoration: underline;
        text-decoration-color: var(--primary);
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
      }
    }

    li[data-depth="1"] a {
      margin-inline-start: var(--space-xs);
    }

    ul {
      margin-block-start: var(--space-3xs);

      a {
        margin-inline-start: var(--space-xs);
      }

      li[data-depth="1"] a {
        margin-inline-start: calc(2 * var(--space-xs));
      }
    }

    @media (width < 64rem) {
      display: none;
    }
  }

  mobile-nav {
    display: none;

    @media (width < 64rem) {
      display: flex;
      align-items: center;
      gap: 2px;
    }
  }

  .hamburger,
  .nav-search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--muted-foreground);
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;

    &:hover {
      color: var(--foreground);
      background-color: color-mix(in oklab, var(--muted) 50%, transparent);
    }

    &:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: -2px;
    }

    svg {
      width: 1rem;
      height: 1rem;
    }
  }

  .hamburger {
    flex-direction: column;
    gap: 4px;
  }

  .hamburger-line {
    display: block;
    width: 1rem;
    height: 2px;
    background-color: currentColor;
    border-radius: 1px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .hamburger[aria-expanded="true"] {
    color: var(--foreground);
    background-color: color-mix(in oklab, var(--muted) 50%, transparent);
  }

  .hamburger[aria-expanded="true"] .hamburger-line:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ── vanam.dev mobile menu: full-width bar dropdown ── */
  .mobile-menu {
    display: none;

    @media (width < 64rem) {
      flex-basis: 100%;
      order: 10;
      inline-size: 100%;
      max-block-size: 50svh;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }

      &.open {
        display: block;
      }

      ul {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        margin: 0;
        padding: 0;
        list-style: none;
      }

      a {
        display: block;
        color: var(--muted-foreground);
        text-decoration-line: none;
        transition: color 0.2s ease;

        &:hover,
        &[aria-current="page"] {
          color: var(--foreground);
        }
      }
    }
  }

  sidebar-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    margin-inline-start: -0.5rem;

    @media (width < 64rem) {
      gap: 2px;
      margin-inline: 0 -0.5rem;
    }
  }

  /* ── vanam.dev ⌘K trigger (desktop only) ── */
  .cmdk-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding-inline: var(--space-3xs);
    color: var(--muted-foreground);
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;

    kbd {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      background: none;
      padding: 0;
    }

    &:hover {
      color: var(--primary);
      border-color: var(--primary);
      background-color: color-mix(in oklab, var(--primary) 10%, transparent);
    }

    @media (width < 64rem) {
      display: none;
    }
  }
</style>

<script>
  function openPalette() {
    document.dispatchEvent(new CustomEvent("open-command-palette"))
  }

  function initSidebar() {
    const hamburger = document.querySelector<HTMLButtonElement>(".hamburger")
    const mobileMenu = document.querySelector<HTMLElement>(".mobile-menu")

    if (hamburger && mobileMenu && !hamburger.dataset.bound) {
      hamburger.dataset.bound = "true"
      hamburger.addEventListener("click", () => {
        const isExpanded = hamburger.getAttribute("aria-expanded") === "true"
        hamburger.setAttribute("aria-expanded", String(!isExpanded))
        mobileMenu.classList.toggle("open")
      })
    }

    // Single delegated outside-click closer: registered once per document
    // (not per navigation) and always queries the *current* menu, so no
    // stale closures accumulate across view transitions.
    if (!document.documentElement.dataset.sidebarBound) {
      document.documentElement.dataset.sidebarBound = "true"
      document.addEventListener("click", (e) => {
        const openMenu =
          document.querySelector<HTMLElement>(".mobile-menu.open")
        const toggle = document.querySelector<HTMLButtonElement>(".hamburger")
        if (!openMenu || !toggle) return
        if (
          !toggle.contains(e.target as Node) &&
          !openMenu.contains(e.target as Node)
        ) {
          toggle.setAttribute("aria-expanded", "false")
          openMenu.classList.remove("open")
        }
      })
    }

    document.querySelectorAll("[data-open-palette]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.bound) return
      ;(btn as HTMLElement).dataset.bound = "true"
      btn.addEventListener("click", openPalette)
    })
  }

  document.addEventListener("astro:page-load", initSidebar)
  document.addEventListener("astro:after-swap", initSidebar)

  initSidebar()
</script>
