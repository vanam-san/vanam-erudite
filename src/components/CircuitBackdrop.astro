    </g>
    <g class="flow up" style="--dur: 8.5s; --delay: -3.5s;">
      <use href="#ckt-l6" class="halo"></use>
      <use href="#ckt-l6" class="core"></use>
    </g>
    <g class="flow up" style="--dur: 11s; --delay: -3s;">
      <use href="#ckt-r1" class="halo"></use>
      <use href="#ckt-r1" class="core"></use>
    </g>
    <g class="flow" style="--dur: 8s; --delay: -5s;">
      <use href="#ckt-r2" class="halo"></use>
      <use href="#ckt-r2" class="core"></use>
    </g>
    <g class="flow" style="--dur: 6.5s; --delay: -2.5s;">
      <use href="#ckt-r3" class="halo"></use>
      <use href="#ckt-r3" class="core"></use>
    </g>
    <g class="flow up" style="--dur: 7.5s; --delay: -0.5s;">
      <use href="#ckt-r4" class="halo"></use>
      <use href="#ckt-r4" class="core"></use>
    </g>
    <g class="flow" style="--dur: 9.5s; --delay: -6.5s;">
      <use href="#ckt-r5" class="halo"></use>
      <use href="#ckt-r5" class="core"></use>
    </g>
    <g class="flow up" style="--dur: 8.2s; --delay: -1.8s;">
      <use href="#ckt-r6" class="halo"></use>
      <use href="#ckt-r6" class="core"></use>
    </g>
    <g class="nodes">
      <circle cx="80" cy="250" r="2.6" style="--delay: -0.8s;"></circle>
      <circle cx="76" cy="628" r="2.6" style="--delay: -2.1s;"></circle>
      <circle cx="1360" cy="318" r="2.6" style="--delay: -1.4s;"></circle>
      <circle cx="1366" cy="704" r="2.6" style="--delay: -2.8s;"></circle>
    </g>
  </svg>
</div>

<style>
  .circuit {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    opacity: 1;

    @media (prefers-color-scheme: light) {
      opacity: 0.75;
    }

    :root[data-theme="light"] & {
      opacity: 0.75;
    }

    svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* Decorative backdrop — skip it entirely on mobile to save
       battery, paint cost, and visual noise. */
    @media (width < 48rem) {
      display: none;
    }
  }

  .traces use {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.1px;
    stroke-linejoin: miter;
    stroke-linecap: square;
    opacity: 0.6;
  }

  .vias .ring {
    fill: var(--background);
    stroke: var(--border);
    stroke-width: 1.1px;
    opacity: 0.75;
  }

  .vias .hole {
    fill: var(--border);
    opacity: 0.8;
  }

  .smd rect {
    fill: none;
    stroke: var(--border);
    stroke-width: 1px;
    opacity: 0.55;
  }

  .pads circle {
    fill: var(--background);
    stroke: var(--border);
    stroke-width: 1.1px;
    opacity: 0.8;
  }

  .flow use {
    fill: none;
    stroke: var(--primary);
    stroke-dasharray: 42 958;
    animation: circuit-flow var(--dur) linear infinite;
    animation-delay: var(--delay);
  }

  .flow.up use {
    animation-direction: reverse;
  }

  .flow use.core {
    stroke-width: 1.4px;
    stroke-linecap: round;
    opacity: 0.9;
    filter: drop-shadow(0 0 4px var(--primary));

    @media (prefers-color-scheme: light) {
      opacity: 0.55;
    }
  }

  .flow use.halo {
    stroke-width: 3.2px;
    opacity: 0.18;

    @media (prefers-color-scheme: light) {
      opacity: 0.1;
    }
  }

  .nodes circle {
    fill: var(--primary);
    opacity: 0.3;
    filter: drop-shadow(0 0 5px var(--primary));
    animation: circuit-blink 3.2s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes circuit-flow {
    0% {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -1000px;
    }
  }

  @keyframes circuit-blink {
    0%,
    to {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow use,
    .nodes circle {
      animation: none;
    }

    .flow use.core {
      opacity: 0.3;
      filter: none;
    }

    .flow use.halo,
    .nodes circle {
      opacity: 0;
    }
  }
</style>
