        pathLength="1000"
        d="M 92 616 L 104 628 V 668 L 92 680 H 70"
      ></path>
      <path
        id="ckt-r1"
        pathLength="1000"
        d="M 1396 -20 V 188 L 1380 204 H 1356 L 1340 220 V 342 L 1356 358 H 1384 L 1400 374 V 572 L 1384 588 H 1352 L 1336 604 V 742 L 1352 758 H 1382 L 1398 774 V 920"
      ></path>
      <path
        id="ckt-r2"
        pathLength="1000"
        d="M 1356 -20 V 112 L 1340 128 V 252 L 1356 268 H 1378 L 1394 284 V 448 L 1378 464 H 1348 L 1332 480 V 626 L 1348 642 H 1368 L 1384 658 V 812 L 1368 828 H 1362 L 1354 836 V 920"
      ></path>
      <path
        id="ckt-r3"
        pathLength="1000"
        d="M 1422 302 H 1398 L 1382 318 H 1360"
      ></path>
      <path
        id="ckt-r4"
        pathLength="1000"
        d="M 1422 688 H 1406 L 1390 704 H 1366"
      ></path>
      <path
        id="ckt-r5"
        pathLength="1000"
        d="M 1384 588 L 1396 600 V 636 L 1408 648 H 1422"
      ></path>
      <path
        id="ckt-r6"
        pathLength="1000"
        d="M 1348 642 L 1336 654 V 690 L 1324 702 H 1306"
      ></path>
    </defs>
    <g class="traces">
      <use href="#ckt-l1"></use>
      <use href="#ckt-l2"></use>
      <use href="#ckt-l3"></use>
      <use href="#ckt-l4"></use>
      <use href="#ckt-l5"></use>
      <use href="#ckt-l6"></use>
      <use href="#ckt-r1"></use>
      <use href="#ckt-r2"></use>
      <use href="#ckt-r3"></use>
      <use href="#ckt-r4"></use>
      <use href="#ckt-r5"></use>
      <use href="#ckt-r6"></use>
    </g>
    <g class="vias">
      <circle class="ring" cx="100" cy="150" r="3.6"></circle>
      <circle class="hole" cx="100" cy="150" r="1.2"></circle>
      <circle class="ring" cx="40" cy="304" r="3.6"></circle>
      <circle class="hole" cx="40" cy="304" r="1.2"></circle>
      <circle class="ring" cx="104" cy="504" r="3.6"></circle>
      <circle class="hole" cx="104" cy="504" r="1.2"></circle>
      <circle class="ring" cx="46" cy="242" r="3.2"></circle>
      <circle class="hole" cx="46" cy="242" r="1.1"></circle>
      <circle class="ring" cx="108" cy="452" r="3.2"></circle>
      <circle class="hole" cx="108" cy="452" r="1.1"></circle>
      <circle class="ring" cx="52" cy="632" r="3.2"></circle>
      <circle class="hole" cx="52" cy="632" r="1.1"></circle>
      <circle class="ring" cx="1340" cy="220" r="3.6"></circle>
      <circle class="hole" cx="1340" cy="220" r="1.2"></circle>
      <circle class="ring" cx="1400" cy="374" r="3.6"></circle>
      <circle class="hole" cx="1400" cy="374" r="1.2"></circle>
      <circle class="ring" cx="1336" cy="604" r="3.6"></circle>
      <circle class="hole" cx="1336" cy="604" r="1.2"></circle>
      <circle class="ring" cx="1394" cy="284" r="3.2"></circle>
      <circle class="hole" cx="1394" cy="284" r="1.1"></circle>
      <circle class="ring" cx="1332" cy="480" r="3.2"></circle>
      <circle class="hole" cx="1332" cy="480" r="1.1"></circle>
      <circle class="ring" cx="1384" cy="658" r="3.2"></circle>
      <circle class="hole" cx="1384" cy="658" r="1.1"></circle>
    </g>
    <g class="smd">
      <rect x="70" y="247" width="10" height="6" rx="1"></rect>
      <rect x="66" y="625" width="10" height="6" rx="1"></rect>
      <rect x="60" y="677" width="10" height="6" rx="1"></rect>
      <rect x="1350" y="315" width="10" height="6" rx="1"></rect>
      <rect x="1356" y="701" width="10" height="6" rx="1"></rect>
      <rect x="1296" y="699" width="10" height="6" rx="1"></rect>
      <rect x="14" y="231" width="8" height="6" rx="1"></rect>
      <rect x="14" y="609" width="8" height="6" rx="1"></rect>
      <rect x="1418" y="299" width="8" height="6" rx="1"></rect>
      <rect x="1418" y="685" width="8" height="6" rx="1"></rect>
    </g>
    <g class="pads">
      <circle cx="80" cy="250" r="2.6"></circle>
      <circle cx="76" cy="628" r="2.6"></circle>
      <circle cx="1360" cy="318" r="2.6"></circle>
      <circle cx="1366" cy="704" r="2.6"></circle>
    </g>
    <g class="flow" style="--dur: 9s; --delay: -2s;">
      <use href="#ckt-l1" class="halo"></use>
      <use href="#ckt-l1" class="core"></use>
    </g>
    <g class="flow up" style="--dur: 13s; --delay: -6s;">
      <use href="#ckt-l2" class="halo"></use>
      <use href="#ckt-l2" class="core"></use>
    </g>
    <g class="flow" style="--dur: 7s; --delay: -4s;">
