---
/* vanam.dev circuit backdrop — static PCB traces with travelling current.
   Persisted across view transitions so the current keeps its position. */
---

<div
  class="circuit"
  aria-hidden="true"
  data-astro-transition-persist="circuit-backdrop"
>
  <svg
    viewBox="0 0 1440 900"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
