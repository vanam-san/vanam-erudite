        d="M 84 -20 V 76 L 100 92 V 210 L 84 226 H 62 L 46 242 V 420 L 62 436 H 92 L 108 452 V 600 L 92 616 H 68 L 52 632 V 780 L 68 796 H 78 L 86 804 V 920"
      ></path>
      <path
        id="ckt-l3"
        pathLength="1000"
        d="M 18 234 H 42 L 58 250 H 80"
      ></path>
      <path
        id="ckt-l4"
        pathLength="1000"
        d="M 18 612 H 34 L 50 628 H 76"
      ></path>
      <path
