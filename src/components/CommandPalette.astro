---
import { getCollection } from "astro:content"
import { NAVIGATION } from "@/consts"

type ResultKind = 'page' | 'blog' | 'gallery' | 'project'
type IndexEntry = { title: string; kind: ResultKind; href: string }

const staticEntries: IndexEntry[] = [
  { title: "Home", kind: "page", href: "/" },
  ...NAVIGATION.map((item) => ({
    title: item.label,
    kind: "page" as const,
    href: item.href,
  })),
  { title: "Tags", kind: "page", href: "/tags" },
  { title: "Legal", kind: "page", href: "/legal" },
]

const posts = await getCollection("blog", ({ data }) => !data.draft)
const galleries = await getCollection("gallery", ({ data }) => !data.draft)
const projects = await getCollection("projects", ({ data }) => !data.draft)

const entries: IndexEntry[] = [
  ...staticEntries,
  ...posts.map((post) => ({
    title: post.data.title,
    kind: "blog" as const,
    href: `/blog/${post.id}`,
  })),
  ...galleries.map((gallery) => ({
    title: gallery.data.title,
    kind: "gallery" as const,
    href: `/gallery/${gallery.id}`,
  })),
  ...projects.map((project) => ({
    title: project.data.name,
    kind: "project" as const,
    href: project.data.link ?? "/projects",
  })),
]

const indexJson = JSON.stringify(entries)
---

<div
  class="cmd-overlay"
  id="cmd-overlay"
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Site search"
  data-astro-transition-persist="command-palette"
>
  <div class="cmd-modal">
    <div class="cmd-input-wrap">
      <svg
        class="cmd-input-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        type="text"
        id="cmd-input"
        class="cmd-input"
        placeholder="Search posts, pages, tags..."
        aria-label="Search posts, pages, tags, and authors"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="cmd-results"
        aria-autocomplete="list"
      >
      <span class="cmd-input-kbd" aria-hidden="true">ESC</span>
    </div>
    <ul
      class="cmd-results"
      id="cmd-results"
      role="listbox"
      aria-label="Search results"
    ></ul>
    <div class="cmd-footer" aria-hidden="true">
      <span class="cmd-footer-hint"><kbd>↑↓</kbd> navigate</span>
      <span class="cmd-footer-hint"><kbd>↵</kbd> open</span>
      <span class="cmd-footer-hint"><kbd>esc</kbd> close</span>
    </div>
  </div>
</div>

<script type="application/json" id="cmd-index" is:inline set:html={indexJson} />

<style>
  .cmd-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 15vh;
    background: color-mix(in oklab, var(--background) 60%, transparent);
    backdrop-filter: blur(var(--blur-sm));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }

  .cmd-overlay[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .cmd-modal {
    width: 100%;
    max-width: 34rem;
    overflow: hidden;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 48px rgb(0 0 0 / 0.25);
    transform: scale(0.98);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cmd-overlay[data-open="true"] .cmd-modal {
    transform: scale(1);
  }

  .cmd-input-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-s);
    border-bottom: 1px solid var(--border);
  }

  .cmd-input-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    color: var(--muted-foreground);
  }

  .cmd-input {
    flex: 1;
    min-width: 0;
    padding: var(--space-xs) 0;
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--foreground);
    background: none;
    border: none;
    outline: none;
  }

  .cmd-input:focus,
  .cmd-input:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .cmd-input::placeholder {
    color: var(--muted-foreground);
  }

  .cmd-input-kbd {
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted-foreground);
    white-space: nowrap;
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
  }

  .cmd-results {
    max-height: 24rem;
    margin: 0;
    padding: var(--space-2xs);
    overflow-y: auto;
    list-style: none;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .cmd-results:empty {
    display: none;
  }

  .cmd-empty {
    padding: var(--space-l) var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted-foreground);
    text-align: center;
  }

  .cmd-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs);
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color 0.1s ease;
  }

  .cmd-item:hover,
  .cmd-item[data-active="true"] {
    background-color: color-mix(in oklab, var(--primary) 8%, transparent);
  }

  .cmd-item-text {
    flex: 1;
    min-width: 0;
  }

  .cmd-item-title {
    overflow: hidden;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cmd-group {
    padding: var(--space-xs) var(--space-xs) var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }

  .cmd-group:not(:first-child) {
    margin-top: var(--space-2xs);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--border);
  }

  .cmd-highlight {
    color: inherit;
    background: color-mix(in oklab, var(--primary) 22%, transparent);
    border-radius: 2px;
  }

  .cmd-item-arrow {
    flex-shrink: 0;
    color: var(--muted-foreground);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .cmd-item:hover .cmd-item-arrow,
  .cmd-item[data-active="true"] .cmd-item-arrow {
    opacity: 1;
  }

  .cmd-footer {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-2xs) var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted-foreground);
    border-top: 1px solid var(--border);
  }

  .cmd-footer-hint {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .cmd-footer-hint kbd {
    font-family: var(--font-mono);
    font-size: inherit;
  }

  @media (width < 48rem) {
    .cmd-overlay {
      padding-top: var(--space-xl);
      padding-inline: var(--space-s);
    }

    .cmd-modal {
      max-width: 100%;
    }

    .cmd-results {
      max-height: 50vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cmd-overlay,
    .cmd-modal {
      transition: none;
    }
  }
</style>

<script>
  type IndexEntry = {
    title: string
    kind: "page" | "blog" | "gallery" | "project"
    href: string
  }

  function readIndex(): IndexEntry[] {
    try {
      const raw = document.getElementById("cmd-index")?.textContent ?? "[]"
      return JSON.parse(raw) as IndexEntry[]
    } catch {
      return []
    }
  }

  function highlight(title: string, query: string): string {
    if (!query) return title.replace(/</g, "&lt;")
    const safe = title.replace(/</g, "&lt;")
    const i = safe.toLowerCase().indexOf(query.toLowerCase())
    if (i < 0) return safe
    return (
      safe.slice(0, i) +
      '<mark class="cmd-highlight">' +
      safe.slice(i, i + query.length) +
      "</mark>" +
      safe.slice(i + query.length)
    )
  }

  function initPalette() {
    const overlay = document.getElementById("cmd-overlay")
    const input = document.getElementById(
      "cmd-input",
    ) as HTMLInputElement | null
    const results = document.getElementById("cmd-results")
    if (!overlay || !input || !results) return
    // A node always belongs to a single document, so if the overlay is
    // already bound, its document-level listeners from the first init
    // are still valid too — nothing to do. (Fresh overlay + already
    // bound document happens with client-side navigation *without*
    // transition persistence: element listeners must be attached to the
    // new nodes while document listeners must not double up.)
    if (overlay.dataset.bound) return
    overlay.dataset.bound = "true"
    const ov: HTMLElement = overlay
    const inp: HTMLInputElement = input
    const res: HTMLElement = results
    const doc = document as Document & { __cmdPaletteDocBound?: boolean }
    if (!doc.__cmdPaletteDocBound) {
      doc.__cmdPaletteDocBound = true
      document.addEventListener("open-command-palette", open)
      document.addEventListener("keydown", onKeydown)
    }

    const entries = readIndex()

    type ResultKind = "page" | "blog" | "gallery" | "project"
    type ResultItem = { title: string; kind: ResultKind; href: string }

    const GROUPS: { kind: ResultKind; label: string }[] = [
      { kind: "blog", label: "Blog" },
      { kind: "gallery", label: "Gallery" },
      { kind: "project", label: "Projects" },
      { kind: "page", label: "Pages" },
    ]
    const MAX_PER_GROUP = 5

    let active = 0
    let current: ResultItem[] = []

    function toItem(e: IndexEntry): ResultItem {
      return { title: e.title, kind: e.kind, href: e.href }
    }

    function staticSearch(query: string): ResultItem[] {
      const q = query.trim().toLowerCase()
      if (q.length === 0) return entries.slice(0, 8).map(toItem)
      return entries
        .filter((e) => e.title.toLowerCase().includes(q))
        .slice(0, 12)
        .map(toItem)
    }

    function syncActive() {
      res.querySelectorAll(".cmd-item").forEach((el, i) => {
        el.setAttribute("data-active", String(i === active))
        el.setAttribute("aria-selected", String(i === active))
      })
      if (current.length > 0) {
        inp.setAttribute("aria-activedescendant", `cmd-item-${active}`)
      } else {
        inp.removeAttribute("aria-activedescendant")
      }
    }

    // Empty query shows a hint — no page list until the user types.
    function paintHint() {
      current = []
      active = 0
      res.innerHTML = `<li class="cmd-empty">Type to search posts, pages and tags</li>`
      inp.setAttribute("aria-expanded", "false")
      inp.removeAttribute("aria-activedescendant")
    }

    function paint(items: ResultItem[], rawQuery: string) {
      const q = rawQuery.trim()
      const unique = dedupe(items)
      if (unique.length === 0) {
        current = []
        active = 0
        res.innerHTML = `<li class="cmd-empty">No results for &ldquo;${rawQuery.replace(/</g, "&lt;")}&rdquo;</li>`
      } else {
        // Group matches by type, capped per group. Headers are not
        // selectable — `current` holds only the rendered links in order.
        const flat: ResultItem[] = []
        let html = ""
        for (const group of GROUPS) {
          const groupItems = unique
            .filter((item) => item.kind === group.kind)
            .slice(0, MAX_PER_GROUP)
          if (groupItems.length === 0) continue
          html += `<li class="cmd-group" aria-hidden="true">${group.label}</li>`
          for (const e of groupItems) {
            const i = flat.length
            flat.push(e)
            html += `<li>
              <a href="${e.href.replace(/"/g, "%22")}" class="cmd-item" id="cmd-item-${i}" role="option" aria-selected="${i === 0}" data-active="${i === 0}" data-index="${i}">
                <span class="cmd-item-text">
                  <span class="cmd-item-title">${highlight(e.title, q)}</span>
                </span>
                <span class="cmd-item-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>`
          }
        }
        current = flat
        active = 0
        res.innerHTML = html
      }
      inp.setAttribute("aria-expanded", current.length > 0 ? "true" : "false")
      syncActive()
    }

    // Normalize hrefs so de-duplication compares like with like
    // (trailing slashes, external URL forms). External URLs keep
    // their origin so distinct sites never collide with local paths.
    function normHref(href: string): string {
      if (/^https?:\/\//i.test(href)) {
        try {
          const u = new URL(href)
          const path =
            u.pathname.length > 1 ? u.pathname.replace(/\/+$/, "") : ""
          return (u.origin + path).toLowerCase()
        } catch {
          return href
        }
      }
      return href.length > 1 ? href.replace(/\/+$/, "") : href
    }

    // Drop duplicate rows: same destination twice (e.g. two projects
    // sharing one placeholder link), plus series chains — subpost rows
    // live under their parent (`/blog/<post>/…`), so one query matching
    // several chain titles still renders a single row per series.
    // First (best) match per destination / series wins.
    function dedupe(items: ResultItem[]): ResultItem[] {
      const seenHref = new Set<string>()
      const seenSeries = new Set<string>()
      const out: ResultItem[] = []
      for (const item of items) {
        const href = normHref(item.href)
        if (seenHref.has(href)) continue
        if (item.kind === "blog") {
          const parts = href.split("/").filter(Boolean)
          if (parts.length > 1 && parts[0] === "blog") {
            const bucket = `/${parts[0]}/${parts[1]}`
            if (seenSeries.has(bucket)) continue
            seenSeries.add(bucket)
          }
        }
        seenHref.add(href)
        out.push(item)
      }
      return out
    }

    // Title-only matching: a row shows if and only if its title
    // contains the query. No content/excerpt matching, so pages that
    // merely mention the term (blog index, author pages, home bio)
    // never appear.
    function runSearch(query: string) {
      const q = query.trim()
      if (q.length === 0) {
        paintHint()
        return
      }
      paint(staticSearch(q), q)
    }

    function open() {
      ov.dataset.open = "true"
      paintHint()
      const target: HTMLInputElement = inp
      setTimeout(() => target.focus(), 0)
    }

    function close() {
      ov.dataset.open = "false"
      inp.value = ""
    }

    function isOpen() {
      return ov.dataset.open === "true"
    }

    function onKeydown(e: KeyboardEvent) {
      const target = e.target as HTMLElement | null
      const typing =
        target &&
        (target.tagName === "INPUT" ||
          target.tagName === "TEXTAREA" ||
          target.isContentEditable)
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault()
        if (isOpen()) close()
        else open()
        return
      }
      if (e.key === "/" && !isOpen() && !typing) {
        e.preventDefault()
        open()
        return
      }
      if (e.key === "Escape" && isOpen()) {
        e.preventDefault()
        close()
        return
      }
      if (!isOpen()) return
      if (e.key === "ArrowDown") {
        e.preventDefault()
        active = (active + 1) % Math.max(current.length, 1)
      } else if (e.key === "ArrowUp") {
        e.preventDefault()
        active =
          (active - 1 + Math.max(current.length, 1)) %
          Math.max(current.length, 1)
      } else if (e.key === "Enter") {
        e.preventDefault()
        // Click the rendered link so the View Transitions router
        // handles same-origin navigation instead of a full reload.
        const link = res.querySelector<HTMLAnchorElement>(
          `.cmd-item[data-index="${active}"]`,
        )
        if (link) link.click()
        else {
          const entry = current[active]
          if (entry) window.location.href = entry.href
        }
        return
      } else {
        return
      }
      syncActive()
    }

    let debounce: ReturnType<typeof setTimeout> | undefined
    inp.addEventListener("input", () => {
      clearTimeout(debounce)
      const value = inp.value
      debounce = setTimeout(() => void runSearch(value), 150)
    })

    ov.addEventListener("click", (e) => {
      if (e.target === ov) close()
    })

    paintHint()
  }

  document.addEventListener("astro:page-load", initPalette)
  document.addEventListener("astro:after-swap", initPalette)
  initPalette()
</script>
