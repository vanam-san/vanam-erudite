---
import SocialIcons from "@/components/SocialIcons.astro"
import { SITE, SOCIALS } from "@/consts"
---

<footer>
  <div class="footer-row">
    <span class="footer-copy">
      &copy; {new Date().getFullYear()}
      {SITE.title}
    </span>
    <nav class="footer-nav" aria-label="Footer">
      <a href="/">Home</a>
      <span class="footer-sep" aria-hidden="true">·</span>
      <a href="/tags">Tags</a>
      <span class="footer-sep" aria-hidden="true">·</span>
      <a href="/legal">Legal</a>
    </nav>
  </div>
  <div class="footer-row">
    <span class="footer-attr">
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
  <SocialIcons links={SOCIALS} class="footer-socials" />
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    min-width: 0;
    max-inline-size: 100%;
    margin-block: var(--space-xl) var(--page-offset-bottom);
    padding-block-start: var(--space-m);
    background: none;
    border: none;
    border-block-start: 2px solid var(--border);
    border-radius: 0;
    box-shadow: none;

    @media (width < 40rem) {
      overflow-x: clip;
    }
  }

  .footer-row {
    display: flex;
    flex-flow: column wrap;
    align-items: center;
    gap: var(--space-2xs);

    @media (width >= 40rem) {
      flex-direction: row;
      gap: var(--space-s);
    }
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted-foreground);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);

    a {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      color: var(--muted-foreground);
      text-decoration: none;
      transition: color 0.2s ease;

      &:hover {
        color: var(--primary);
      }
    }
  }

  .footer-sep {
    font-size: var(--step--3);
    color: var(--border);
  }

  .footer-attr {
    font-family: var(--font-mono);
    font-size: var(--step--3);
    color: var(--muted-foreground);

    a {
      color: var(--muted-foreground);
      text-decoration: none;
      transition: color 0.2s ease;

      &:hover {
        color: var(--primary);
      }
    }
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3xs) var(--space-2xs);
    min-width: 0;
    max-inline-size: 100%;
    margin: 0;
    padding: 0;
    list-style: none;

    :global(li) {
      min-width: 0;
    }

    :global(li a) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      color: var(--muted-foreground);
      text-decoration: none;
      transition: color 0.2s ease;

      &:hover,
      &:focus-visible {
        color: var(--primary);
      }

      :global(svg) {
        width: 1rem;
        height: 1rem;
      }

      @media (width < 30rem) {
        min-width: 2.5rem;
        min-height: 2.5rem;
      }
    }
  }
</style>
