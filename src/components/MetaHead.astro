---
import { SITE, UMAMI } from "@/consts"
import { DEFAULT_THEME_ID, THEMES, THEME_STORAGE_KEY } from "@/lib/themes"

// Serialized into the pre-paint script below (inline scripts can't import).
const themeModes: Record<string, string> = Object.fromEntries(
  THEMES.map((theme) => [theme.id, theme.mode]),
)
const validThemeIds = THEMES.map((theme) => theme.id)
---

<head>
  <meta charset="utf-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  >
  <meta name="generator" content={Astro.generator}>

  <meta name="HandheldFriendly" content="True">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content={SITE.title}>
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  >

  <meta
    name="theme-color"
    content="#0b1120"
    media="(prefers-color-scheme: dark)"
  >
  <meta
    name="theme-color"
    content="#f0f4f8"
    media="(prefers-color-scheme: light)"
  >

  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="sitemap" href="/sitemap-index.xml">
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL("rss.xml", Astro.site)}
  >

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Space+Grotesk:wght@300..700&display=swap"
    rel="stylesheet"
  >

  <!-- Restore the saved palette before first paint (avoids a theme flash).
    Mirrors the palette's designed mode to `data-theme` for legacy CSS. -->
  <script
    is:inline
    define:vars={{
      themeModes,
      validThemeIds,
      storageKey: THEME_STORAGE_KEY,
      defaultId: DEFAULT_THEME_ID,
    }}
  >
    try {
      var stored = localStorage.getItem(storageKey)
      var id = validThemeIds.indexOf(stored) !== -1 ? stored : defaultId
      var mode = themeModes[id]
      var root = document.documentElement
      root.dataset.palette = id
      if (mode === "light" || mode === "dark") {
        root.dataset.theme = mode
      } else {
        // System palette (Ocean Depths): honor an explicit legacy choice,
        // otherwise leave `data-theme` unset for the OS default.
        var legacy = localStorage.getItem("theme")
        if (legacy === "light" || legacy === "dark") {
          root.dataset.theme = legacy
        } else {
          delete root.dataset.theme
        }
      }
    } catch (e) {
      // Storage unavailable — defaults from CSS apply.
    }
  </script>

  {UMAMI.websiteId && (
    <script
      is:inline
      defer
      src={`https://${UMAMI.host}/script.js`}
      data-website-id={UMAMI.websiteId}
    />
  )}

  <slot />
</head>
