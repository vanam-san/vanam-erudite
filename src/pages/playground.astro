---
import MetaPage from "@/components/MetaPage.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import Layout from "@/layouts/Layout.astro"
import CurrencyTracker from "@/components/bento/CurrencyTracker.astro"
import BouncingSquare from "@/components/bento/BouncingSquare.astro"
import CRTClock from "@/components/bento/CRTClock.astro"
import MatrixRain from "@/components/bento/MatrixRain.astro"
import Starfield from "@/components/bento/Starfield.astro"
import WaveInterference from "@/components/bento/WaveInterference.astro"
---

<Layout>
  <MetaPage slot="head" title="Experimental Bento Cards" />
  <ScrollToTop floating />

  <div class="page-header">
    <h1 class="page-title">Experimental Bento Cards</h1>
    <p class="page-description">Live data feeds and generative visuals</p>
  </div>

  <div class="bento-grid bento-grid-playground">
    <Starfield />
    <CRTClock />
    <MatrixRain />
    <BouncingSquare />
    <CurrencyTracker />
    <WaveInterference />
  </div>
</Layout>
