---
import MetaPage from "@/components/MetaPage.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts, getRecentGalleries } from "@/lib/content"
import { HERO } from "@/consts"
import { getCollection } from "astro:content"

const posts = await getPosts()
const [latestPost, ...restPosts] = posts
const recentPosts = restPosts.slice(0, 5)
const recentGalleries = (await getRecentGalleries(3)).map((gallery) => ({
  id: gallery.id,
  title: gallery.data.title,
  count: gallery.data.photos.length,
}))

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort(
    (a, b) =>
      (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0),
  )
  .slice(0, 3)

const firstName = HERO.name.split(" ")[0]
const nameEmphasis = HERO.name === "Your Name" ? HERO.name : `${firstName}!`

const formatShortDate = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "short", day: "numeric" })
---

<Layout wide>
  <MetaPage slot="head" />
  <ScrollToTop floating />

  <div class="bento">
    <!-- WHO — photo with name and title -->
    <section class="bento-tile bento-who" aria-label={HERO.name}>
      <img
        src="/static/avatar.svg"
        alt={HERO.name}
        class="bento-avatar"
        width="96"
        height="96"
      >
      <div class="bento-who-copy">
        <h1 class="bento-name">Hey, I'm <em>{nameEmphasis}</em></h1>
        <p class="bento-role">{HERO.title}</p>
      </div>
    </section>

    <!-- INTRO — text plus link to about -->
    <section class="bento-tile bento-intro" aria-label="Introduction">
      <p class="bento-tagline">{HERO.bio}</p>
      <span class="bento-note" data-tail="up" style="--tail-x: 22%">
        More on the <a href="/about">about page</a>.
      </span>
      <a
        href="/about"
        class="bento-tile-link-overlay"
        aria-label={`About ${firstName}`}
      ></a>
    </section>

    <!-- LATEST POST — banner feature -->
    {latestPost && (
      <article class="bento-tile bento-latest" aria-label="Latest post">
        <p class="bento-kicker">Latest post</p>
        <h2 class="bento-tile-title">{latestPost.data.title}</h2>
        <div class="bento-latest-body">
          <span class="bento-note" data-tail="down" style="--tail-x: 70%">
            Read my latest post!
          </span>
        </div>
        <a
          href={`/blog/${latestPost.id}`}
          class="bento-tile-link-overlay"
          aria-label={`Latest post: ${latestPost.data.title}`}
        ></a>
      </article>
    )}

    <!-- WRITING — recent posts -->
    <section class="bento-tile bento-writing" aria-label="Recent blog posts">
      <h2 class="bento-tile-title">Blog</h2>
      <ul class="bento-list">
        {recentPosts.map((post) => (
          <li class="bento-list-item">
            <a href={`/blog/${post.id}`} class="bento-list-link">
              <span class="bento-list-prefix">&rarr;</span>
              <span class="bento-list-title">{post.data.title}</span>
              <span class="bento-list-meta">
                {formatShortDate(post.data.date)}
              </span>
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/blog"
        class="bento-tile-link-overlay"
        aria-label="Open blog"
      ></a>
    </section>

    <!-- PROJECTS -->
    <section class="bento-tile bento-projects" aria-label="Recent projects">
      <h2 class="bento-tile-title">Projects</h2>
      <ul class="bento-list">
        {projects.map((project) => (
          <li class="bento-list-item">
            <a
              href={project.data.link ?? `/projects#${project.id}`}
              target={project.data.link ? "_blank" : undefined}
              rel={project.data.link ? "noopener noreferrer" : undefined}
              class="bento-list-link"
            >
              <span class="bento-list-prefix">&rarr;</span>
              <span class="bento-list-title">{project.data.name}</span>
              <span class="bento-list-meta">
                {project.data.tags?.[0] ?? ""}
              </span>
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/projects"
        class="bento-tile-link-overlay"
        aria-label="Open projects"
      ></a>
    </section>

    <!-- PHOTOGRAPHY -->
    <section class="bento-tile bento-photo" aria-label="Recent photography">
      <h2 class="bento-tile-title">Photography</h2>
      <ul class="bento-list">
        {recentGalleries.map((gallery) => (
          <li class="bento-list-item">
            <a href={`/gallery/${gallery.id}`} class="bento-list-link">
              <span class="bento-list-prefix">&rarr;</span>
              <span class="bento-list-title">{gallery.title}</span>
              <span class="bento-list-meta">{gallery.count} photos</span>
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/gallery"
        class="bento-tile-link-overlay"
        aria-label="Open gallery"
      ></a>
    </section>

    <!-- LOCAL / WEATHER -->
    <section
      class="bento-tile bento-weather"
      aria-label="Local time and weather"
    >
      <header class="bento-tile-header">
        <div>
          <h2 class="bento-tile-title">
            <span
              class="bento-weather-emoji"
              id="weather-emoji"
              aria-hidden="true"
              >☀️</span
            >
            Here &amp; now
          </h2>
        </div>
        <span class="bento-weather-temp" id="weather-temp">--°C</span>
      </header>
      <div class="bento-weather-rows">
        <div class="bento-weather-row">
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Time</span>
            <span class="bento-weather-value" id="split-time">--:--</span></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Date</span>
            <span class="bento-weather-value" id="split-date">---</span></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Feels</span>
            <span class="bento-weather-value" id="weather-feels"
              >--°C</span
            ></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Wind</span>
            <span class="bento-weather-value" id="weather-wind">--</span></span
          >
        </div>
        <div class="bento-weather-row">
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Humidity</span>
            <span class="bento-weather-value" id="weather-humidity"
              >--%</span
            ></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Rise</span>
            <span class="bento-weather-value" id="weather-rise">--</span></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Set</span>
            <span class="bento-weather-value" id="weather-set">--</span></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">TZ</span>
            <span class="bento-weather-value" id="split-tz">UTC</span></span
          >
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function updateTime() {
    const now = new Date()

    const timeEl = document.getElementById("split-time")
    if (timeEl) {
      timeEl.textContent = now.toLocaleTimeString("en-US", {
        hour: "2-digit",
        minute: "2-digit",
        hour12: true,
      })
    }

    const dateEl = document.getElementById("split-date")
    if (dateEl) {
      dateEl.textContent = now.toLocaleDateString("en-US", {
        weekday: "short",
        month: "short",
        day: "numeric",
      })
    }

    const tzEl = document.getElementById("split-tz")
    if (tzEl) {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone
      const offset = now.getTimezoneOffset()
      const offsetHours = Math.floor(Math.abs(offset) / 60)
      const offsetMinutes = Math.abs(offset) % 60
      const offsetSign = offset <= 0 ? "+" : "-"
      const short = tz.split("/").pop()?.replace(/_/g, " ") ?? tz
      tzEl.textContent = `${short} UTC${offsetSign}${offsetHours}:${offsetMinutes.toString().padStart(2, "0")}`
      tzEl.title = tz
    }
  }

  function setText(id: string, value: string) {
    const el = document.getElementById(id)
    if (el) el.textContent = value
  }

  async function fetchWeather() {
    const controller = new AbortController()
    const timeout = setTimeout(() => controller.abort(), 8000)
    try {
      const res = await fetch("https://wttr.in/?format=j1", {
        signal: controller.signal,
      })
      const data = await res.json()
      const current = data.current_condition[0]
      const astronomy = data.weather?.[0]?.astronomy?.[0]

      const temp = current.temp_C
      const feels = current.FeelsLikeC
      const desc = current.weatherDesc[0].value as string
      const code = current.weatherCode as string
      const wind = `${current.windspeedKmph} km/h`
      const humidity = `${current.humidity}%`

      let emoji = "☀️"
      if (code === "116") emoji = "⛅"
      else if (code === "119" || code === "122") emoji = "☁️"
      else if (
        ["176", "263", "266", "293", "296", "299", "353", "356"].includes(code)
      )
        emoji = "🌧️"
      else if (["200", "386", "389", "392", "395"].includes(code)) emoji = "⛈️"
      else if (
        [
          "227",
          "230",
          "320",
          "326",
          "329",
          "332",
          "338",
          "368",
          "371",
        ].includes(code)
      )
        emoji = "❄️"
      else if (["248", "260"].includes(code)) emoji = "🌫️"

      setText("weather-temp", `${temp}°C`)
      setText("weather-emoji", emoji)
      setText("weather-feels", `${feels}°C`)
      setText("weather-wind", wind)
      setText("weather-humidity", humidity)
      if (astronomy) {
        setText("weather-rise", astronomy.sunrise)
        setText("weather-set", astronomy.sunset)
      }
      const tempEl = document.getElementById("weather-temp")
      if (tempEl) tempEl.title = desc
    } catch {
      // Timeout, abort, network failure, or bad payload — tile keeps
      // its "--" placeholders.
      setText("weather-temp", "--°C")
      setText("weather-feels", "--°C")
      setText("weather-wind", "--")
      setText("weather-humidity", "--%")
    } finally {
      clearTimeout(timeout)
    }
  }

  updateTime()
  setInterval(updateTime, 1000)
  fetchWeather()
</script>
