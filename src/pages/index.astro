---
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import MetaPage from "@/components/MetaPage.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import { HERO, SITE, TEMPLATE } from "@/consts"
import Layout from "@/layouts/Layout.astro"
import { getPosts, getRecentGalleries } from "@/lib/content"

const [posts, galleries, projects] = await Promise.all([
  getPosts(),
  getRecentGalleries(3),
  getCollection("projects", ({ data }) => !data.draft),
])

const formatShortDate = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" })

const homepageUrl = new URL("/", Astro.site ?? Astro.url).href
const templateSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${homepageUrl}#website`,
      url: homepageUrl,
      name: SITE.title,
      description: TEMPLATE.description,
      inLanguage: SITE.locale,
      about: { "@id": `${homepageUrl}#template` },
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": `${homepageUrl}#template`,
      name: SITE.title,
      url: homepageUrl,
      description: TEMPLATE.description,
      codeRepository: TEMPLATE.repository,
      license: "https://opensource.org/license/mit",
      runtimePlatform: "Astro",
    },
  ],
}).replace(/</g, "\\u003c")

const sections = [
  {
    title: "Writing",
    href: "/blog",
    entries: posts.slice(0, 6).map(({ id, data }) => ({
      title: data.title,
      description: data.description,
      href: `/blog/${id}`,
      image: data.image,
      meta: formatShortDate(data.date),
    })),
  },
  {
    title: "Selected projects",
    href: "/projects",
    entries: projects
      .sort((a, b) => (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0))
      .slice(0, 3)
      .map(({ data }) => ({
        title: data.name,
        description: data.description,
        href: data.link,
        image: data.image,
        meta: data.tags?.[0],
        external: true,
      })),
  },
  {
    title: "Photography",
    href: "/gallery",
    entries: galleries.map(({ id, data }) => ({
      title: data.title,
      description: data.description,
      href: `/gallery/${id}`,
      image: data.cover,
      meta: `${data.photos.length} photos`,
    })),
  },
]
---

<Layout wide>
  <Fragment slot="head">
    <MetaPage
      title={TEMPLATE.showcase ? TEMPLATE.title : undefined}
      description={TEMPLATE.showcase ? TEMPLATE.description : undefined}
    />
    {TEMPLATE.showcase && <script type="application/ld+json" set:html={templateSchema} />}
  </Fragment>
  <ScrollToTop floating />

  <div class="home">
    <header class="hero">
      <div class="hero-copy">
        <p class="metadata">{HERO.title}</p>
        <h1>{HERO.name}</h1>
        <p class="hero-bio">{HERO.bio}</p>
        <div class="hero-links">
          <a href="/about">About me <span aria-hidden="true">↗</span></a>
          <a href="/projects">View projects <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <img src="/static/avatar.svg" alt="" width="240" height="240" class="portrait" />
    </header>

    {TEMPLATE.showcase && (
      <section class="editorial-section" aria-labelledby="template-title">
        <header class="section-heading">
          <h2 id="template-title">{TEMPLATE.title}</h2>
          <a href={TEMPLATE.repository}>Get the template <span aria-hidden="true">↗</span></a>
        </header>
        <p class="template-description">
          Build a developer portfolio, personal blog, or project showcase with this MIT-licensed
          Astro starter. It includes Markdown posts, a photo gallery, and eight color themes.
          Follow the <a href="/blog/setup-guide/">portfolio template setup guide</a> to make it yours.
        </p>
      </section>
    )}

    {sections.map(({ title, href, entries: [featured, ...entries] }) => (
      <section class="editorial-section">
        <header class="section-heading">
          <h2>{title}</h2>
          <a href={href} aria-label={`Browse all ${title.toLowerCase()}`}>Browse all <span aria-hidden="true">↗</span></a>
        </header>

        {featured && (
          <div class="section-grid">
            <article class="feature">
              {featured.image && (
                <Image
                  src={featured.image}
                  alt=""
                  width={Math.min(featured.image.width, 1200)}
                  class="feature-image"
                />
              )}
              <div class="feature-copy">
                {featured.meta && <p class="metadata">{featured.meta}</p>}
                <h3>
                  <a
                    href={featured.href}
                    target={"external" in featured ? "_blank" : undefined}
                    rel={"external" in featured ? "noopener noreferrer" : undefined}
                  >{featured.title}</a>
                </h3>
                <p>{featured.description}</p>
              </div>
            </article>

            {entries.length > 0 && (
              <ul class="entry-list">
                {entries.map((entry) => (
                  <li>
                    <a
                      href={entry.href}
                      target={"external" in entry ? "_blank" : undefined}
                      rel={"external" in entry ? "noopener noreferrer" : undefined}
                    >
                      <span>{entry.title}</span>
                      {entry.meta && <span class="metadata">{entry.meta}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )}
      </section>
    ))}

    <!-- LOCAL / WEATHER -->
    <section
      class="bento-tile bento-weather"
      aria-label="Local time and weather"
    >
      <header class="bento-tile-header">
        <div>
          <h2 class="bento-tile-title">
            <span class="bento-weather-icon" id="weather-icon" aria-hidden="true"></span>
            Here &amp; now
          </h2>
        </div>
        <span class="bento-weather-temp" id="weather-temp">--°C</span>
      </header>
      <p class="metadata" id="weather-status" role="status">Weather updates require JavaScript.</p>
      <div class="bento-weather-rows">
        <div class="bento-weather-row">
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Time</span>
            <span class="bento-weather-value" id="split-time">--:--</span></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Date</span>
            <span class="bento-weather-value" id="split-date">---</span></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Feels</span>
            <span class="bento-weather-value" id="weather-feels"
              >--°C</span
            ></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Wind</span>
            <span class="bento-weather-value" id="weather-wind">--</span></span
          >
        </div>
        <div class="bento-weather-row">
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Humidity</span>
            <span class="bento-weather-value" id="weather-humidity"
              >--%</span
            ></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Rise</span>
            <span class="bento-weather-value" id="weather-rise">--</span></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">Set</span>
            <span class="bento-weather-value" id="weather-set">--</span></span
          >
          <span class="bento-weather-item"
            ><span class="bento-weather-label">TZ</span>
            <span class="bento-weather-value" id="split-tz">UTC</span></span
          >
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home {
    display: grid;
    gap: var(--space-xl-2xl);
  }

  .home .bento-weather {
    grid-area: auto;
  }

  #weather-status {
    margin-block: 0 var(--space-2xs);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(10rem, 24vw, 17rem);
    align-items: center;
    gap: var(--space-l-xl);
    min-height: 24rem;
    padding-block: var(--space-l-xl);
  }

  .hero h1 {
    margin-block: var(--space-2xs) var(--space-s);
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7.5rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
    overflow-wrap: anywhere;
  }

  .hero-bio {
    max-width: 42ch;
    color: var(--muted-foreground);
    font-size: var(--step-1);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    margin-block-start: var(--space-m);
  }

  .hero-links a,
  .section-heading a {
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-underline-offset: 0.25em;
  }

  .hero-links a:first-child {
    padding: var(--space-2xs) var(--space-s);
    color: var(--foreground);
    background: var(--background);
    border: 1px solid var(--primary);
    text-decoration: none;
  }

  .hero-links a:first-child:hover {
    text-decoration: underline;
  }

  .hero-links a + a {
    align-self: center;
  }

  .portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--muted);
    border: 1px solid var(--border);
  }

  .editorial-section {
    border-block-start: 1px solid var(--border);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    padding-block: var(--space-s);
  }

  .section-heading h2,
  .feature h3 {
    margin: 0;
    font-family: var(--font-display);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .section-heading h2 {
    font-size: var(--step-3);
  }

  .template-description {
    max-inline-size: var(--measure);
    color: var(--muted-foreground);
  }

  .template-description a {
    color: var(--foreground);
    text-decoration-color: var(--primary);
  }

  .section-grid {
    display: grid;
    gap: var(--space-m);
  }

  .section-grid:has(.entry-list) {
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  }

  .feature {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    background: color-mix(in oklab, var(--background) 92%, var(--primary));
  }

  .feature:focus-within {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .feature-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }

  .feature-copy {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-s-m);
  }

  .feature h3 {
    font-size: var(--step-2);
  }

  .feature p {
    margin: 0;
    color: var(--muted-foreground);
  }

  .feature a,
  .entry-list a {
    color: var(--foreground);
    text-decoration: none;
  }

  .feature a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .feature a:hover,
  .entry-list a:hover,
  .section-heading a:hover {
    color: var(--primary);
  }

  .metadata {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--border);
  }

  .entry-list li {
    border-block-end: 1px solid var(--border);
  }

  .entry-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);
    padding-block: var(--space-xs);
  }

  .entry-list a span:first-child {
    overflow-wrap: anywhere;
  }

  @media (width < 42rem) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .portrait {
      grid-row: 1;
      max-width: 10rem;
    }

    .section-grid:has(.entry-list) {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function updateTime() {
    const now = new Date()

    const timeEl = document.getElementById("split-time")
    if (timeEl) {
      timeEl.textContent = now.toLocaleTimeString("en-US", {
        hour: "2-digit",
        minute: "2-digit",
        hour12: true,
      })
    }

    const dateEl = document.getElementById("split-date")
    if (dateEl) {
      dateEl.textContent = now.toLocaleDateString("en-US", {
        weekday: "short",
        month: "short",
        day: "numeric",
      })
    }

    const tzEl = document.getElementById("split-tz")
    if (tzEl) {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone
      const offset = now.getTimezoneOffset()
      const offsetHours = Math.floor(Math.abs(offset) / 60)
      const offsetMinutes = Math.abs(offset) % 60
      const offsetSign = offset <= 0 ? "+" : "-"
      const short = tz.split("/").pop()?.replace(/_/g, " ") ?? tz
      tzEl.textContent = `${short} UTC${offsetSign}${offsetHours}:${offsetMinutes.toString().padStart(2, "0")}`
      tzEl.title = tz
    }
  }

  function setText(id: string, value: string) {
    const el = document.getElementById(id)
    if (el) el.textContent = value
  }

  function formatReading(value: unknown, unit: string) {
    if (typeof value === "number" || (typeof value === "string" && value.trim())) {
      const reading = Number(value)
      if (Number.isFinite(reading)) return `${reading}${unit}`
    }

    return "—"
  }

  async function fetchWeather() {
    setText("weather-status", "Loading weather…")
    const controller = new AbortController()
    const timeout = setTimeout(() => controller.abort(), 8000)
    try {
      const res = await fetch("https://wttr.in/?format=j1", {
        signal: controller.signal,
      })
      if (!res.ok) throw new Error(`Weather request failed (${res.status})`)

      const data = await res.json()
      const current = data?.current_condition?.[0]
      const astronomy = data.weather?.[0]?.astronomy?.[0]

      const temp = formatReading(current?.temp_C, "°C")
      if (temp === "—") throw new Error("Weather response is missing the temperature")

      const desc = current.weatherDesc?.[0]?.value
      const city = data.nearest_area?.[0]?.areaName?.[0]?.value
      const code = String(current.weatherCode)

      let icon = ""
      if (code === "113") icon = "\\|/ (o) /|\\"
      else if (code === "116") icon = "(o) (_)~"
      else if (code === "119" || code === "122") icon = "(_)~(_)"
      else if (
        ["176", "263", "266", "293", "296", "299", "353", "356"].includes(code)
      )
        icon = "(_) ///"
      else if (["200", "386", "389", "392", "395"].includes(code)) icon = "(_) /Z/"
      else if (
        [
          "227",
          "230",
          "320",
          "326",
          "329",
          "332",
          "338",
          "368",
          "371",
        ].includes(code)
      )
        icon = "(_) *.*"
      else if (["248", "260"].includes(code)) icon = "~ === ~"

      setText("weather-temp", temp)
      setText("weather-icon", icon)
      setText("weather-feels", formatReading(current.FeelsLikeC, "°C"))
      setText("weather-wind", formatReading(current.windspeedKmph, " km/h"))
      setText("weather-humidity", formatReading(current.humidity, "%"))
      setText("weather-rise", astronomy?.sunrise || "—")
      setText("weather-set", astronomy?.sunset || "—")
      const summary = [city, desc].filter((value) => typeof value === "string" && value.trim())
      setText("weather-status", summary.join(" · ") || "Current conditions")
    } catch {
      setText("weather-status", "Weather unavailable. Local time is shown below.")
    } finally {
      clearTimeout(timeout)
    }
  }

  updateTime()
  setInterval(updateTime, 1000)
  fetchWeather()
</script>
